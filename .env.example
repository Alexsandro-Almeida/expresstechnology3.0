# Vercel Function: exemplo com o plano gratuito da Groq (formato OpenAI Chat Completions)
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=adicione_a_chave_no_painel_da_vercel
AI_MODEL=openai/gpt-oss-120b

# Supabase: use a nova secret key no servidor. Nunca exponha no navegador.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Resend: o domínio storeexpressshop.com precisa estar verificado
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Express Technology <site@storeexpressshop.com>
